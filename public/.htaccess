# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"

# Disable directory listing
Options -Indexes

# Enable rewrite engine
RewriteEngine On

# Block access to dotfiles
RewriteRule (^\.|/\.) - [F,L]

# Block access to includes, sql, scripts directories
RewriteRule ^(includes|sql|scripts)/ - [F,L]

# Serve PHP files through Apache's PHP module
AddType application/x-httpd-php .php

# Default charset
AddDefaultCharset UTF-8

# Disable server signature
ServerSignature Off

# Cache static media and fonts
<FilesMatch "\.(png|jpg|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>

# Never cache JavaScript, CSS, HTML, or PHP
<FilesMatch "\.(css|js|html|php)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
</FilesMatch>
